{
  "name": "@dmytro-rudenko/tma-web",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmytro-rudenko/tma-starter.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "i18next": "^23.16.0",
    "react": "^18.3.1",
    "react-i18next": "^15.1.0",
    "socket.io-client": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dmytro-rudenko/tma-testing": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "i18next": "^23.16.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.1.0",
    "socket.io-client": "^4.8.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  }
}
