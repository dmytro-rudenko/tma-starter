{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/nest-core/**/*.ts",
    "src/nest-bot/**/*.ts",
    "src/nest-payments/**/*.ts",
    "src/testing/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
