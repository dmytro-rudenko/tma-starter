  "sideEffects": [
    "./dist/cjs/**"
  ],
  "bin": {
    "tma-bot": "dist/cjs/nest-bot/bin/tma-bot.js",
    "tma-test-pg": "dist/cjs/testing/bin/tma-test-pg.js"
  },
  "exports": {
    "./nest-core": {
      "types": "./dist/cjs/nest-core/index.d.ts",
      "default": "./dist/cjs/nest-core/index.js"
    },
    "./nest-bot": {
      "types": "./dist/cjs/nest-bot/index.d.ts",
      "default": "./dist/cjs/nest-bot/index.js"
    },
    "./nest-payments": {
      "types": "./dist/cjs/nest-payments/index.d.ts",
      "default": "./dist/cjs/nest-payments/index.js"
    },
    "./testing": {
      "types": "./dist/cjs/testing/index.d.ts",
      "default": "./dist/cjs/testing/index.js"
    },
    "./testing/dom": {
      "types": "./dist/cjs/testing/dom/index.d.ts",
      "default": "./dist/cjs/testing/dom/index.js"
    },
    "./web": {
      "types": "./dist/esm/web/index.d.ts",
      "default": "./dist/esm/web/index.js"
    },
    "./web/react": {
      "types": "./dist/esm/web/react/index.d.ts",
      "default": "./dist/esm/web/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.cjs.json && tsc --noEmit -p tsconfig.esm.json",
    "pretest": "pnpm run build",
    "test": "jest && vitest run"
  },
  "peerDependencies": {
